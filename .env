# Copy this file to .env before running setup.bat / docker compose up

# --- PostgreSQL ---
POSTGRES_USER=honeypot_admin
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=honeypot_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend / Security ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# --- Default admin account (seeded on first startup) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@honeypot-platform.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_FULL_NAME=Platform Administrator

# --- Email Alerts (Phase 3) ---
# Set EMAIL_ENABLED=true and fill in SMTP credentials to enable real alert delivery.
# Leave EMAIL_ENABLED=false to run without email — everything else works normally,
# and HIGH/CRITICAL alerts are still recorded in the database and shown on the dashboard.
EMAIL_ENABLED=false

# Option A: Gmail — use an App Password (not your normal password):
#   https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true

# Option B: Mailtrap (development sandbox — emails never actually leave Mailtrap):
#   https://mailtrap.io -> Email Testing -> SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_USE_TLS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=alerts@honeypot-platform.local
SMTP_FROM_NAME=Honeynet SOC

# Where alert emails are sent
ADMIN_ALERT_EMAIL=admin@honeypot-platform.com
# Sessions at or above this severity trigger an email: low | medium | high | critical
ALERT_MIN_SEVERITY=high
# Used to build "View Session" / "Open Dashboard" links inside alert emails
FRONTEND_BASE_URL=http://localhost

# --- Threat Intelligence (Phase 6) ---
# Each is independent and optional. Leave blank to skip that provider —
# its section of the lookup will show "not configured" instead of erroring.
#   AbuseIPDB:  https://www.abuseipdb.com/account/api  (free tier: 1000 checks/day)
#   VirusTotal: https://www.virustotal.com/gui/my-apikey (free tier: 4 req/min)
#   OTX:        https://otx.alienvault.com/api  (free, generous limits)
ABUSEIPDB_API_KEY=9fa55755237158c759764991bfa30258d8ddee771b72d323fc72671ccc67b30c4bfa55cdb003b563
VIRUSTOTAL_API_KEY=809775fab9e2ea940593ca535d45403c22778a8d4ca1fb95497ea489da71c4bf
OTX_API_KEY=518f95339c40673a517d89889c9c0e2e8a337a2fb08366e6d53387906ca38002
# How long a lookup is cached before re-fetching (avoids burning through
# free-tier rate limits on repeat views of the same IP)
THREAT_INTEL_CACHE_HOURS=24
THREAT_INTEL_REQUEST_TIMEOUT_SECONDS=8
